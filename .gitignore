# banco e dados coletados — nunca versionados
data/
*.db
*.db-wal
*.db-shm

# payloads brutos arquivados
raw/
exports/

# bases externas — grandes demais para versionar (o dataset de 2023 tem 2,5 GB,
# e o GitHub recusa arquivo acima de 100 MB)
*.zip
*.parquet
datasets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# segredos (chaves de agregador)
.env
.env.*
!.env.example

# sistema
.DS_Store
