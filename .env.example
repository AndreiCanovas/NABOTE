# Copie para .env e preencha. .env nunca é versionado.
# No passo 0 nada disto é usado ainda — a coleta (passo 1) roda no Bluesky,
# que não exige credencial.

# Passo 1 — Bluesky Jetstream (gratuito, sem chave)
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Passo 5 — agregador terceiro de X (só quando o pipeline já estiver validado)
# NABOTE_X_PROVIDER=twitterapi_io
# NABOTE_X_API_KEY=

# Teto de gasto por ciclo, em USD. O planner corta a cauda se estourar —
# orçamento é código, não disciplina.
NABOTE_BUDGET_USD_PER_CYCLE=1.00
